# The subset of the project code style that every editor honours.
# IntelliJ users should additionally import config/intellij-code-style.xml,
# which carries the wrapping and blank-line rules this format cannot express.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 120
continuation_indent_size = 8

[*.sql]
indent_size = 4

[*.{xml,yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
